{
  "name": "paris-1380",
  "version": "4.4.0",
  "private": true,
  "description": "Paris à travers le temps : maquettes 3D interactives de Paris vers 1380 et en 1789, construites sur les données du projet ALPAGE",
  "type": "module",
  "scripts": {
    "extract": "python3 tools/extract_alpage.py",
    "fetch:alpage": "python3 tools/fetch_alpage.py",
    "extract:epochs": "python3 tools/extract_epochs.py",
    "extract:1789": "python3 tools/extract_1789.py",
    "build": "node tools/build.mjs",
    "shot": "node tools/shot.mjs",
    "test": "node tools/test.mjs && node tools/test1789.mjs",
    "test:1380": "node tools/test.mjs",
    "test:1789": "node tools/test1789.mjs",
    "inshot": "node tools/inshot.mjs",
    "thumbs": "python3 tools/make_thumbs.py"
  },
  "license": "SEE LICENSE IN README.md",
  "devDependencies": {
    "clipper-lib": "^6.4.2",
    "esbuild": "0.21.5",
    "three": "0.160.1"
  }
}
