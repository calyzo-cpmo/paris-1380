{
  "name": "paris-1380",
  "version": "4.6.0",
  "private": true,
  "description": "Paris à travers le temps : maquettes 3D interactives de Lutèce vers 250, de Paris vers 1380, en 1789, en 1889 et en 1900, et passage de l'une à l'autre sur place, construites sur des données ouvertes (ALPAGE, APUR, Paris 1900)",
  "type": "module",
  "scripts": {
    "extract": "python3 tools/extract_alpage.py",
    "fetch:alpage": "python3 tools/fetch_alpage.py",
    "extract:epochs": "python3 tools/extract_epochs.py",
    "extract:1789": "python3 tools/extract_1789.py",
    "extract:1889": "python3 tools/extract_1889.py",
    "extract:1900": "python3 tools/extract_1889.py 1900",
    "build": "node tools/build.mjs",
    "shot": "node tools/shot.mjs",
    "test": "node tools/test_toits.mjs && node tools/test.mjs && node tools/test1789.mjs && node tools/test_lutece.mjs && node tools/test1889.mjs && node tools/test1900.mjs && node tools/test_accueil.mjs",
    "test:1380": "node tools/test.mjs",
    "test:1789": "node tools/test1789.mjs",
    "test:lutece": "node tools/test_lutece.mjs",
    "test:1889": "node tools/test1889.mjs",
    "test:1900": "node tools/test1900.mjs",
    "inshot": "node tools/inshot.mjs",
    "thumbs": "python3 tools/make_thumbs.py",
    "vignettes": "python3 tools/vignettes.py",
    "test:toits": "node tools/test_toits.mjs",
    "test:accueil": "node tools/test_accueil.mjs"
  },
  "license": "SEE LICENSE IN README.md",
  "devDependencies": {
    "clipper-lib": "^6.4.2",
    "esbuild": "0.21.5",
    "three": "0.160.1"
  }
}
